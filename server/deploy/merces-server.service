[Unit]
Description=Merces server (verifier, coin registry, RPC proxy)
After=network-online.target

[Service]
User=merces
Group=merces
WorkingDirectory=/opt/merces/server
EnvironmentFile=/opt/merces/state/server.env
ExecStart=/usr/bin/node src/index.mjs
Restart=always
RestartSec=3
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/opt/merces/state
PrivateTmp=true

[Install]
WantedBy=multi-user.target
